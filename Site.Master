<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="HospitalParking.SiteMaster" %>
<!DOCTYPE html>
<html lang="zh-Hant">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title><%: Page.Title %> - 醫療院區智慧停車場車輛管理系統</title>
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <!-- HSPMS Theme CSS -->
    <link href="<%= ResolveUrl("~/Content/css/site.css?v=" + DateTime.Now.Ticks) %>" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="formMain" runat="server" onsubmit="return false;">
        <asp:ScriptManager ID="smGlobal" runat="server" EnablePageMethods="true"></asp:ScriptManager>
        
        <!-- 頂部主要導覽列 -->
        <nav class="navbar navbar-expand-lg navbar-dark navbar-hospital sticky-top">
            <div class="container-fluid">
                <% if (IsEmployeePortal) { %>
                    <!-- 員工專用導覽列：不顯示其他後台管理功能頁面 -->
                    <a class="navbar-brand d-flex align-items-center" href="Employee_Portal.aspx">
                        <span class="badge bg-white text-primary p-2 me-2 rounded-3 shadow-sm">
                            <i class="bi bi-p-square-fill fs-5"></i>
                        </span>
                        <div class="d-flex align-items-center">
                            <span class="fw-bold">醫療院區車輛管理系統</span>
                            <span class="badge bg-white bg-opacity-25 text-white ms-2 fw-normal small">
                                <i class="bi bi-person-badge me-1"></i>員工申請專區
                            </span>
                        </div>
                    </a>

                    <div class="d-flex align-items-center text-white gap-2 ms-auto">
                        <div class="d-flex align-items-center bg-white bg-opacity-10 px-3 py-1 rounded-pill small">
                            <i class="bi bi-shield-check text-success me-1"></i>
                            <span>全院同仁/醫師線上自助申辦服務</span>
                        </div>
                    </div>
                <% } else { %>
                    <!-- 管理者/工作人員導覽列：顯示完整管理功能選單 -->
                    <a class="navbar-brand d-flex align-items-center" href="Admin_Dashboard.aspx">
                        <span class="badge bg-white text-primary p-2 me-2 rounded-3 shadow-sm">
                            <i class="bi bi-p-square-fill fs-5"></i>
                        </span>
                        <span>醫療院區車輛管理系統 <small class="fw-normal opacity-75 fs-6 ms-1">HSPMS</small></span>
                    </a>

                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navContent">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                            <li class="nav-item">
                                <a class="nav-link <%= IsActivePage("Admin_Dashboard") %>" href="Admin_Dashboard.aspx">
                                    <i class="bi bi-speedometer2 me-1"></i>管理看板
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= IsActivePage("Permit_Management") %>" href="Permit_Management.aspx">
                                    <i class="bi bi-card-checklist me-1"></i>車籍維護
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= IsActivePage("Zone_Management") %>" href="Zone_Management.aspx">
                                    <i class="bi bi-geo-alt-fill me-1"></i>場域維護
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= IsActivePage("Dept_Management") %>" href="Dept_Management.aspx">
                                    <i class="bi bi-hospital me-1"></i>科室維護
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= IsActivePage("Employee_Portal") %>" href="Employee_Portal.aspx">
                                    <i class="bi bi-person-badge me-1"></i>員工申請
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link <%= IsActivePage("Admin_Management") %>" href="Admin_Management.aspx">
                                    <i class="bi bi-people-fill me-1"></i>人員維護
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-mobile-alert <%= IsActivePage("Mobile_Check") %>" href="Mobile_Check.aspx">
                                    <i class="bi bi-camera-fill me-1"></i>現場巡檢查核
                                </a>
                            </li>
                        </ul>

                        <div class="d-flex align-items-center text-white gap-3 mt-3 mt-lg-0">
                            <div class="d-none d-md-flex align-items-center bg-white bg-opacity-10 px-3 py-1 rounded-pill small">
                                <i class="bi bi-shield-check text-success me-1"></i>
                                <span>連線狀態: 本院區域網路 (正常)</span>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-light dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i>
                                    <span><%: CurrentAdminName %></span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li><h6 class="dropdown-header">登入身分：<%: CurrentAdminRoleName %></h6></li>
                                    <li><a class="dropdown-item" href="Admin_Dashboard.aspx"><i class="bi bi-gear me-2"></i>系統主控台</a></li>
                                    <li><a class="dropdown-item" href="Admin_Management.aspx"><i class="bi bi-people me-2"></i>管理者與巡檢人員維護</a></li>
                                    <li><a class="dropdown-item" href="Zone_Management.aspx"><i class="bi bi-geo-alt me-2"></i>停車場域維護</a></li>
                                    <li><a class="dropdown-item" href="Dept_Management.aspx"><i class="bi bi-hospital me-2"></i>部門科室維護</a></li>
                                    <li><a class="dropdown-item" href="Mobile_Check.aspx"><i class="bi bi-phone me-2"></i>切換行動巡檢模式</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger fw-semibold" href="Login.aspx?action=logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>登出管理系統
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </nav>

        <!-- 主體工作區 -->
        <main class="flex-grow-1 animate-fade-in py-3">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>

        <!-- 頁尾 -->
        <footer class="bg-white border-top py-3 text-muted small mt-auto">
            <div class="container-fluid px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div>
                    <strong>醫療院區智慧停車場管理系統 (HSPMS)</strong> &copy; <%= DateTime.Now.Year %> 總務處車籍管理中心. All rights reserved.
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span><i class="bi bi-database me-1 text-primary"></i>Microsoft SQL Server 2025</span>
                    <span><i class="bi bi-cpu me-1 text-primary"></i>.NET Framework 4.8 3-Tier</span>
                </div>
            </div>
        </footer>
    </form>

    <!-- jQuery 3.7.1 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap 5.3.2 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Chart.js 4.4.1 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <!-- SheetJS (xlsx) for Excel (.xlsx/.xls/csv) import/export -->
    <script src="<%= ResolveUrl("~/Content/xlsx.full.min.js") %>"></script>

    <asp:ContentPlaceHolder ID="ScriptContent" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
